# ----------------------------------------------------------------------------
# Turistando SP — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite segredos reais.
# ----------------------------------------------------------------------------

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco (para colocar no ar — em produção é obrigatório)
# Sem isso, roda localmente num arquivo no seu PC.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Segurança do painel
# Gere um segredo forte:  openssl rand -base64 32
AUTH_SECRET=
# Senha do /admin (também dá para trocar dentro do painel). Padrão: turistando
ADMIN_PASSWORD=turistando

# Gemini — organiza o texto ao publicar (opcional; também configurável no painel)
# Deixe o modelo em branco: o app escolhe sozinho um modelo disponível na sua conta.
GEMINI_API_KEY=
GEMINI_MODEL=
