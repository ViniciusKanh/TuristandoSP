# ----------------------------------------------------------------------------
# Turistando SP — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite segredos reais.
# ----------------------------------------------------------------------------

# URL base do site (SEO: sitemap, robots, canonical, Open Graph)
# Em produção o padrão já é https://turistandosp.me — só defina aqui se usar outro domínio.
# Em desenvolvimento (npm run dev) o padrão é http://localhost:3000.
SITE_URL=https://turistandosp.me

# Banco (para colocar no ar — em produção é obrigatório)
# Sem isso, roda localmente num arquivo no seu PC.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Segurança do painel
# Gere um segredo forte:  openssl rand -base64 32
AUTH_SECRET=
# Senha do /admin (também dá para trocar dentro do painel). Padrão: turistando
ADMIN_PASSWORD=turistando

# Gemini — organiza o texto ao publicar (opcional; também configurável no painel)
# Deixe o modelo em branco: o app escolhe sozinho um modelo disponível na sua conta.
GEMINI_API_KEY=
GEMINI_MODEL=

# Comentários (Giscus via GitHub Discussions — opcional, grátis)
# Ative Discussions no repo, instale o app giscus.app e gere os ids em giscus.app
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Contato (opcional — aparece na página /contato)
# (defina também no painel em Configurações, se preferir)

# Newsletter (opcional) — endpoint do formulário (Buttondown, Formspree, etc.)
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Imagens no Vercel Blob (opcional) — se definido, as fotos vão pro Blob em vez do banco (mais leve)
BLOB_READ_WRITE_TOKEN=
