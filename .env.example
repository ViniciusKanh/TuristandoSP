# ----------------------------------------------------------------------------
# Turistando SP — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite segredos reais.
# ----------------------------------------------------------------------------

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de dados — Turso / libSQL
# Crie o banco: turso db create turistando-sp && turso db show turistando-sp
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Autenticação do painel (autor único)
# Gere um segredo forte: openssl rand -base64 32
AUTH_SECRET=KhLnUNuygma+v5VGWula8qiv0rpQZHKiTwM6rw+haK0=
# Senha de acesso ao /admin (padrão de desenvolvimento: turistando)
ADMIN_PASSWORD=turistando

# Armazenamento de imagens (camada trocável) — Vercel Blob por padrão
BLOB_READ_WRITE_TOKEN=

# Integração Gemini (organização automática de texto/fotos ao publicar)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Analytics (opcional, sem comprometer privacidade)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
